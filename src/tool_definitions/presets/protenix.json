"ligand\": {\n          \"ligand\": \"CCD_6OI\",\n          \"count\": 2\n        }\n      },\n      {\n        \"ligand\": {\n          \"ligand\": \"CCD_MG\",\n          \"count\": 3\n        }\n      }\n    ],\n    \"name\": \"7wux\"\n  }\n]",
