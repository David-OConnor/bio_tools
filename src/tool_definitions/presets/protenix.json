  {
    "id": "constraints_7st3_5sak",
    "label": "Pocket and contact constraints \u00b7 7ST3, 5SAK",
    "description": "Official constraint example: an antibody\u2013antigen complex with no constraint, a pocket constraint, and a token contact, and a protein\u2013ligand complex with an atom contact, on protenix_base_constraint_v0.5.0. The example's 15 MB of precomputed MSAs are not bundled, so Protenix searches for them on the Protenix MSA server.",
    "source_url": "https://github.com/bytedance/Protenix/blob/4c355be4553512f72453ecbfb65e69f4c35d1413/examples/example_constraint_msa.json",
    "values": {
      "input_mode": "text",
      "input_json": "[\n  {\n    \"sequences\": [\n      {\n        \"proteinChain\": {\n          \"sequence\": \"\",\n          \"count\": 1\n        }\n      },\n      {\n        \"proteinChain\": {\n          \"sequence\": \"EVKLVESGGGLVQPGGSLRLSCAASGSIFSINTMGWYRQTPGKQRDLVADISSGGSTKYGDSVKGRFTISRDNTKNTVYLQMNSLKPEDTAVYYCYGLSYSNDDYWGQGTQVTVSS\",\n          \"count\": 1\n        }\n      }\n    ],\n    \"modelSeeds\": [],\n    \"name\": \"7st3_base\"\n  },\n  {\n    \"sequences\": [\n      {\n        \"proteinChain\": {\n          \"sequence\": \"\",\n          \"count\": 1\n        }\n      },\n      {\n        \"proteinChain\": {\n          \"sequence\": \"EVKLVESGGGLVQPGGSLRLSCAASGSIFSINTMGWYRQTPGKQRDLVADISSGGSTKYGDSVKGRFTISRDNTKNTVYLQMNSLKPEDTAVYYCYGLSYSNDDYWGQGTQVTVSS\",\n          \"count\": 1\n        }\n      }\n    ],\n    \"modelSeeds\": [],\n    \"name\": \"7st3_pocket_1_8\",\n    \"constraint\": {\n      \"pocket\": {\n        \"binder_chain\": {\n          \"entity\": 2,\n          \"copy\": 1\n        },\n        \"contact_residues\": [\n          {\n            \"entity\": 1,\n            \"copy\": 1,\n            \"position\": 69\n          }\n        ],\n        \"max_distance\": 8\n      }\n    }\n  },\n  {\n    \"sequences\": [\n      {\n        \"proteinChain\": {\n          \"sequence\": \"\",\n          \"count\": 1\n        }\n      },\n      {\n        \"proteinChain\": {\n          \"sequence\": \"EVKLVESGGGLVQPGGSLRLSCAASGSIFSINTMGWYRQTPGKQRDLVADISSGGSTKYGDSVKGRFTISRDNTKNTVYLQMNSLKPEDTAVYYCYGLSYSNDDYWGQGTQVTVSS\",\n          \"count\": 1\n        }\n      }\n    ],\n    \"modelSeeds\": [],\n    \"name\": \"7st3_token_1_15\",\n    \"constraint\": {\n      \"contact\": [\n        {\n          \"entity1\": 1,\n          \"copy1\": 1,\n          \"position1\": 72,\n          \"entity2\": 2,\n          \"copy2\": 1,\n          \"position2\": 103,\n          \"max_distance\": 15\n        }\n      ]\n    }\n  },\n  {\n    \"sequences\": [\n      {\n        \"proteinChain\": {\n          \"sequence\": \"\",\n          \"count\": 1\n        }\n      },\n      {\n        \"ligand\": {\n          \"ligand\": \"CCD_ZRY\",\n          \"count\": 1\n        }\n      }\n    ],\n    \"modelSeeds\": [],\n    \"name\": \"5sak_base\"\n  },\n  {\n    \"sequences\": [\n      {\n        \"proteinChain\": {\n          \"sequence\": \"\",\n          \"count\": 1\n        }\n      },\n      {\n        \"ligand\": {\n          \"ligand\": \"CCD_ZRY\",\n          \"count\": 1\n        }\n      }\n    ],\n    \"modelSeeds\": [],\n    \"name\": \"5sak_atom_1_3_5\",\n    \"constraint\": {\n      \"contact\": [\n        {\n          \"entity1\": 1,\n          \"copy1\": 1,\n          \"position1\": 311,\n          \"atom1\": \"CG2\",\n          \"entity2\": 2,\n          \"copy2\": 1,\n          \"position2\": 1,\n          \"atom2\": \"C10\",\n          \"max_distance\": 5,\n          \"min_distance\": 3\n        }\n      ]\n    }\n  }\n]",
