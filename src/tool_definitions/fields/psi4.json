    {
      "name": "psi4_input",
      "label": "Psithon input",
      "kind": "textarea",
      "default": "",
      "required": true,
      "help": "Enter one molecule block, optional memory and settings, then energy(), optimize() or frequency(). An optimization can be followed by frequencies at the same level of theory. Use a listed method and basis. Accepts declarative Psithon keywords and calculation calls.",
      "options": [],
      "rows": 17,
      "minimum": null,
      "maximum": null,
      "step": null,
      "maxlength": 35000,
      "accept": "",
      "task": "",
      "group": "Input deck",
      "input_modes": "text"
    },
